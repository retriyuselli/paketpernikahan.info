<IfModule mod_rewrite.c>
    RewriteEngine On

    # Redirect /public/* ke /* (fix URL lama yang terindeks Google)
    RewriteCond %{REQUEST_URI} ^/public/(.*)$
    RewriteRule ^ https://paketpernikahan.co.id/%1 [L,R=301]

    # Force non-www
    RewriteCond %{HTTP_HOST} ^www\.paketpernikahan\.co\.id [NC]
    RewriteRule ^ https://paketpernikahan.co.id%{REQUEST_URI} [L,R=301]

    # Force HTTPS
    RewriteCond %{HTTPS} off
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Arahkan semua request ke folder public
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Blokir akses langsung ke file sensitif
<FilesMatch "(\.(htaccess|htpasswd|env)|composer\.json|composer\.lock|package\.json|package-lock\.json)$">
    Require all denied
</FilesMatch>
