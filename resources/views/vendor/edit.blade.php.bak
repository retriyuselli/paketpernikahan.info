        /* Toggle switch */
        .toggle-track {
            position: relative;
            display: inline-block;
            width: 44px;
            height: 24px;
            border-radius: 9999px;
            background: #d1d5db;
            cursor: pointer;
            transition: background .2s;
            flex-shrink: 0;
        }
        .toggle-track.on { background: var(--sage-green); }
        .toggle-thumb {
            position: absolute;
            top: 3px; left: 3px;
            width: 18px; height: 18px;
            background: #fff;
            border-radius: 9999px;
            box-shadow: 0 1px 3px rgba(0,0,0,.2);
            transition: transform .2s;
        }
        .toggle-track.on .toggle-thumb { transform: translateX(20px); }
